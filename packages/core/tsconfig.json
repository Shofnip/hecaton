{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    // For globals the runtime provides (URL, structuredClone). Importing Node's
    // I/O modules here is blocked by ESLint, not by the absence of types.
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
