{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    // For globals the runtime provides (URL, structuredClone). Importing Node's
    // I/O modules here is blocked by ESLint, not by the absence of types.
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  // Tests and fakes are versioned like any other code, but must never reach
  // dist: the app ships dist, and a fake launcher that reports success for
  // everything has no business inside a build users run. Type-checked by
  // tsconfig.test.json instead.
  "exclude": ["src/**/*.test.ts", "src/testing/**"]
}
