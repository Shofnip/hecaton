{
  // The build tsconfig excludes *.test.ts so they stay out of dist, which also
  // meant they were never type-checked. This config covers everything with
  // noEmit, so a broken test signature fails CI instead of passing quietly.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  // apps/* matches nothing until the Electron shell lands. It is listed now
  // because the alternative is discovering, later, that the shell's tests were
  // never type-checked - which is the failure tsconfig.test.json exists to fix.
  "include": ["packages/*/src/**/*.ts", "apps/*/src/**/*.ts", "tests/**/*.ts", "vitest*.config.ts"]
}
